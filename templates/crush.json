{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "context_paths": [
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "skills_paths": [
      ".crush/skills",
      ".agents/skills",
      ".claude/skills",
      ".cursor/skills"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "name": "block-destructive",
        "matcher": "^bash$",
        "command": "./hooks/block-destructive.sh",
        "timeout": 10
      },
      {
        "name": "protect-plan",
        "matcher": "^(edit|write|multiedit)$",
        "command": "./hooks/protect-plan-files.sh",
        "timeout": 10
      }
    ]
  }
}
